# Postgres. On Vercel the Neon integration sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Better Auth. Secret: a random string of at least 32 characters.
BETTER_AUTH_SECRET=
# Optional on Vercel (derived from the deployment URL); required elsewhere.
BETTER_AUTH_URL=
# Magic-link email via Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Local development only: Mailpit from compose.yaml catches emails instead of Resend.
MAILPIT_URL=
