    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "chart.js": "4.5.1",
    "ical.js": "2.2.1",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.3"
  }
